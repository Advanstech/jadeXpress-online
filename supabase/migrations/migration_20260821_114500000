-- Profile preferences (notification toggles etc.) + allow the owner to update them.
alter table public.profiles
  add column if not exists preferences jsonb not null default '{}'::jsonb;

-- Column-level grants: the owner may only update these profile columns themselves.
revoke update on public.profiles from authenticated;
grant update (full_name, phone, avatar_url, preferences) on public.profiles to authenticated;
grant update (pin_hash, pin_salt, pin_fail_count, pin_locked_until) on public.profiles to service_role;
