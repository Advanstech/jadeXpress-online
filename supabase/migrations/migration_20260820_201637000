create or replace function public.fulfill_order_stock(p_order_id uuid) returns void language plpgsql security definer set search_path = public as $$ begin update public.products p set stock_quantity = greatest(0, p.stock_quantity - oi.quantity) from public.order_items oi where oi.order_id = p_order_id and oi.product_id = p.id; end; $$;